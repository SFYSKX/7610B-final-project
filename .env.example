# Copy this file to .env only when configuring your own deployment.
# Supply your own Ethereum Sepolia RPC URL, deployer key and deployed Safe address.
# Leave all secrets local. Never use the VITE_ prefix for secrets.
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
SAFE_ADDRESS=
CONFIRM_TESTNET_DEPLOY=no
SETTLER_PRIVATE_KEY=

# Optional: stable identifier for a test NFT collection deployment request.
# NFT_DEPLOYMENT_ID=demo-v1
# Optional: original deployment transaction hash, only for verified recovery.
# NFT_DEPLOYMENT_TX=
# Optional: endpoint for manually operated local scripts.
# LOCAL_RPC_URL=http://127.0.0.1:8545
